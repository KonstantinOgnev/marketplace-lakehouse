		table fact_orders
			lineageTag: 0c0f1e29-0a35-4b07-9580-7ff885cc0a7d
			sourceLineageTag: [gold].[fact_orders]

			measure 'Total Orders' = ```

					DISTINCTCOUNT(fact_orders[order_key])

					```
				formatString: 0
				lineageTag: 0b7d0b8c-d32c-4197-8ade-564a747095a4

				changedProperty = Name

			measure GMV = ```

					IF(
					    HASONEVALUE(fact_orders[currency]),
					    SUM(fact_orders[recognized_gmv_amount]),
					    BLANK()
					)

					```
				formatString: 0
				lineageTag: b19b72b4-546b-4df6-a852-708373276b1a

				changedProperty = Name

				changedProperty = FormatString

			measure 'Total Order Amount' = ```

					IF(
					    HASONEVALUE(fact_orders[currency]),
					    SUM(fact_orders[order_amount]),
					    BLANK()
					)

					```
				lineageTag: 44dda698-c465-400d-a5c1-b2318312da10

				changedProperty = Name

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Average Order Value' = ```

					DIVIDE(
					    [Total Order Amount],
					    [Total Orders]
					)

					```
				lineageTag: f5b92209-566a-4c01-8dd1-d06306097ee3

				changedProperty = Name

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Top Seller GMV Share' = ```

					VAR SellerGMV =
					    ADDCOLUMNS(
					        ALL(dim_seller[seller_id]),
					        "@SellerGMV", CALCULATE([GMV])
					    )
					VAR TopSellerGMV =
					    MAXX(SellerGMV, [@SellerGMV])
					VAR TotalGMV =
					    CALCULATE(
					        [GMV],
					        REMOVEFILTERS(dim_seller)
					    )
					RETURN
					    DIVIDE(TopSellerGMV, TotalGMV)

					```
				formatString: #,0.00%;-#,0.00%;#,0.00%
				lineageTag: 155a0b49-504e-4471-ae05-65b0e82dd34b

				changedProperty = Name

				changedProperty = FormatString

			measure 'Funnel Users — Latest Date' =

					VAR LatestDate =
					    MAXX(
					        FILTER(
					            ALL('agg_conversion_funnel'),
					            'agg_conversion_funnel'[unique_users] > 0
					        ),
					        'agg_conversion_funnel'[metric_date]
					    )
					RETURN
					    CALCULATE(
					        SUM('agg_conversion_funnel'[unique_users]),
					        'agg_conversion_funnel'[metric_date] = LatestDate
					    )
				formatString: 0
				lineageTag: c9cfb840-34d3-4205-ace7-e5838dfe4ed0

				changedProperty = Name

