		table fact_payments
			lineageTag: a61c9c3e-0209-4d8a-af3c-d0a5e4dce325
			sourceLineageTag: [gold].[fact_payments]

			measure 'Successful Payments' = ```

					CALCULATE(
					    COUNTROWS(fact_payments),
					    fact_payments[is_successful] = TRUE()
					)

					```
				formatString: 0
				lineageTag: 5ac6aeb2-2e78-4dc6-a8b5-19dcbea1d1f9

				changedProperty = Name

			measure 'Completed Payment Attempts' = ```

					CALCULATE(
					    COUNTROWS(fact_payments),
					    FILTER(
					        fact_payments,
					        fact_payments[is_successful] = TRUE()
					            || fact_payments[is_failed] = TRUE()
					    )
					)

					```
				formatString: 0
				lineageTag: 39d6b36e-faed-4634-817a-0f363843e4b7

				changedProperty = Name

			measure 'Payment Success Rate' = ```

					DIVIDE(
					    [Successful Payments],
					    [Completed Payment Attempts]
					)

					```
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: d1cdac75-046e-4dfc-a91a-973c6eb77956

				changedProperty = Name

				changedProperty = FormatString

			measure 'Cancelled Orders' = ```

					CALCULATE(
					    [Total Orders],
					    fact_orders[order_status] = "CANCELLED"
					)

					```
				formatString: 0
				lineageTag: eec76868-e3d5-43f6-8147-b15ac44b2c26

				changedProperty = Name

			measure 'Cancellation Rate' = ```

					DIVIDE(
					    [Cancelled Orders],
					    CALCULATE(
					        [Total Orders],
					        REMOVEFILTERS(fact_orders[order_status])
					    )
					)

					```
				lineageTag: 3a67331e-4e95-4bfa-a7ab-39250684fc2a

				changedProperty = Name

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Recognized GMV Rate' = ```

					DIVIDE(
					    [GMV],
					    [Total Order Amount]
					)

					```
				lineageTag: 1882398c-3982-415c-8624-b16c926f4f60

				changedProperty = Name

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Payment Success Rate by Currency' =

					VAR _SelectedCurrencies =
					    VALUES(fact_orders[currency])
					RETURN
					    CALCULATE(
					        [Payment Success Rate],
					        TREATAS(
					            _SelectedCurrencies,
					            fact_payments[currency]
					        )
					    )
				lineageTag: 7545b3c1-0df0-4462-aa04-115518d433c5

				changedProperty = Name

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'View to Cart Conversion Rate' = ```

					VAR ViewUsers =
					    CALCULATE(
					        [Funnel Users — Latest Date],
					        REMOVEFILTERS('agg_conversion_funnel'[funnel_step]),
					        'agg_conversion_funnel'[funnel_step] = "PRODUCT_VIEW"
					    )
					VAR CartUsers =
					    CALCULATE(
					        [Funnel Users — Latest Date],
					        REMOVEFILTERS('agg_conversion_funnel'[funnel_step]),
					        'agg_conversion_funnel'[funnel_step] = "ADD_TO_CART"
					    )
					RETURN
					    DIVIDE(CartUsers, ViewUsers)

					```
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: 2748f640-ebeb-49ba-910f-90a0f05a4d2e

				changedProperty = Name

				changedProperty = FormatString

			measure 'Cart to Order Conversion Rate' = ```

					VAR CartUsers =
					    CALCULATE(
					        [Funnel Users — Latest Date],
					        REMOVEFILTERS('agg_conversion_funnel'[funnel_step]),
					        'agg_conversion_funnel'[funnel_step] = "ADD_TO_CART"
					    )
					VAR OrderUsers =
					    CALCULATE(
					        [Funnel Users — Latest Date],
					        REMOVEFILTERS('agg_conversion_funnel'[funnel_step]),
					        'agg_conversion_funnel'[funnel_step] = "ORDER_CREATED"
					    )
					RETURN
					    DIVIDE(OrderUsers, CartUsers)

					```
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: 730158c4-9f6b-4040-a22d-00f106690a92

				changedProperty = Name

				changedProperty = FormatString

			measure 'Order to Payment Conversion Rate' = ```

					VAR OrderUsers =
					    CALCULATE(
					        [Funnel Users — Latest Date],
					        REMOVEFILTERS('agg_conversion_funnel'[funnel_step]),
					        'agg_conversion_funnel'[funnel_step] = "ORDER_CREATED"
					    )
					VAR PaymentUsers =
					    CALCULATE(
					        [Funnel Users — Latest Date],
					        REMOVEFILTERS('agg_conversion_funnel'[funnel_step]),
					        'agg_conversion_funnel'[funnel_step] = "PAYMENT_SUCCEEDED"
					    )
					RETURN
					    DIVIDE(PaymentUsers, OrderUsers)

					```
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: af528cda-da14-45f9-8214-37bc863077ca

				changedProperty = Name

				changedProperty = FormatString

			measure 'View to Cart Drop-off Rate' = ```

					1 - [View to Cart Conversion Rate]

					```
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: 9e1329cf-53d7-47d4-bcfc-c0e436dae35a

				changedProperty = Name

				changedProperty = FormatString

			measure 'Cart to Order Drop-off Rate' = ```

					1 - [Cart to Order Conversion Rate]

					```
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: 5d14ef1a-9dcd-4cdb-b1a6-af91114c1b5b

				changedProperty = Name

				changedProperty = FormatString

			measure 'Order to Payment Drop-off Rate' = ```

					1 - [Order to Payment Conversion Rate]

					```
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: b81b09c3-114a-4509-80eb-64b088991007

				changedProperty = Name

				changedProperty = FormatString

			measure 'Funnel Drop-off Rate' = ```

					VAR SelectedTransition =
					    SELECTEDVALUE('Funnel Transitions'[Transition])
					RETURN
					    SWITCH(
					        SelectedTransition,
					        "View to Cart", [View to Cart Drop-off Rate],
					        "Cart to Order", [Cart to Order Drop-off Rate],
					        "Order to Payment", [Order to Payment Drop-off Rate],
					        BLANK()
					    )

					```
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: f66ecd05-ce20-40a6-b553-997c03ed4bf4

				changedProperty = Name

				changedProperty = FormatString

